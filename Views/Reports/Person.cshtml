@model Person
@{ ViewData["Title"] = "تقرير: " + Model.Name; }
<div class="d-flex justify-content-between mb-3 no-print"><h3>تقرير الشخص</h3><button onclick="window.print()" class="btn btn-primary">طباعة</button></div>
<div class="card mb-3"><div class="card-body"><div class="row">
    <div class="col-3 text-center">@if (Model.HasPhoto) { <img src="@Url.Action("Photo", "People", new { id = Model.Id })" class="img-thumbnail" style="max-height:180px" /> }</div>
    <div class="col-9">
        <h4>@Model.Name</h4>
        <div>الصفة: @Model.Capacity?.DisplayName() &nbsp;|&nbsp; @Model.FunctionAddress</div>
        <div>الدور: @Model.RolePlayed</div>
        <div>التحصيل الدراسي: @Model.Education &nbsp;|&nbsp; محل السكن: @Model.Residence</div>
        <div>الهاتف: <span dir="ltr">@Model.Phone</span> &nbsp;|&nbsp; محافظة العمل: @Model.Governorate?.Name / @Model.Office?.Name</div>
        <div>الدورات الكشفية: @Model.ScoutCourses &nbsp;|&nbsp; الشارات: @Model.BadgesCount &nbsp;|&nbsp; موظف: @(Model.IsEmployee ? "نعم" : "لا")</div>
    </div>
</div></div></div>
<div class="card"><div class="table-responsive"><table class="table mb-0">
    <thead><tr><th>#</th><th>التاريخ</th><th>النوع</th><th>المحافظة</th><th>المكان</th></tr></thead>
    <tbody>
    @foreach (var a in Model.Activities.OrderBy(x => x.Date))
    {
        <tr><td>@a.Id</td><td>@a.Date?.ToString("yyyy-MM-dd")</td><td>@a.ActivityType.DisplayName()</td><td>@a.Governorate?.Name</td><td>@a.ActivityPlace</td></tr>
    }
    </tbody>
</table></div></div>
<p class="mt-2">عدد الأنشطة: @Model.Activities.Count</p>
