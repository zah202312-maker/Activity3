@model List<Activity>
@{
    var office = (Office)ViewBag.Office;
    var person = (Person?)ViewBag.Person;
    var from = (DateTime?)ViewBag.From;
    var to = (DateTime?)ViewBag.To;
    ViewData["Title"] = "تقرير أنشطة مكتب " + office.Name;
}
<style>
    @@media print {
        @@page { size: A4 landscape; margin: 12mm; }
        .report-table { font-size: 10pt; }
        .report-table th, .report-table td { padding: 4px 6px; }
        .report-table thead { display: table-header-group; }
        .report-table tr { break-inside: avoid; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0">تقرير أنشطة مكتب</h3>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
        <button onclick="window.print()" class="btn btn-primary">طباعة / حفظ PDF</button>
    </div>
</div>
<div class="alert alert-info no-print py-2 small">
    لحفظ التقرير كملف PDF: اضغط «طباعة / حفظ PDF» ثم اختر من قائمة الطابعة «Save as PDF» أو «Microsoft Print to PDF».
</div>

<div class="card mb-3"><div class="card-body">
    <h4 class="mb-3">تقرير أنشطة مكتب: @office.Name</h4>
    <div class="row g-2">
        <div class="col-sm-6 col-lg-3"><b>المكتب:</b> @office.Name</div>
        <div class="col-sm-6 col-lg-3"><b>المحافظة:</b> @(office.Governorate?.Name ?? "-")</div>
        <div class="col-sm-6 col-lg-3"><b>الشخص مقيّم النشاط:</b> @(person?.Name ?? "كل الأشخاص")</div>
        <div class="col-sm-6 col-lg-3"><b>الفترة:</b> من @(from?.ToString("yyyy-MM-dd") ?? "البداية") إلى @(to?.ToString("yyyy-MM-dd") ?? "الآن")</div>
    </div>
</div></div>

<div class="card"><div class="table-responsive"><table class="table table-bordered mb-0 report-table">
    <thead><tr>
        <th>ت</th><th>التاريخ</th><th>نوع النشاط</th><th>مكان النشاط</th><th>القسم</th><th>الشعبة</th>
        <th>مقيّمو النشاط</th><th>عدد الأفراد</th><th>الكلفة</th><th>التقييم</th>
    </tr></thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="10" class="text-center text-muted py-4">لا توجد أنشطة مطابقة</td></tr>
    }
    @{ var i = 0; }
    @foreach (var a in Model)
    {
        i++;
        <tr>
            <td>@i</td>
            <td class="text-nowrap">@a.Date?.ToString("yyyy-MM-dd")</td>
            <td>@a.ActivityType.DisplayName()</td>
            <td>@a.ActivityPlace</td>
            <td>@a.Section?.Name</td>
            <td>@a.Subsid?.Name</td>
            <td>@string.Join("، ", a.People.Select(p => p.Name))</td>
            <td>@a.NumberBeneficiaries</td>
            <td>@a.Cost</td>
            <td>@(a.OverallEvaluation ?? "لم يُقيَّم")</td>
        </tr>
    }
    </tbody>
    <tfoot><tr>
        <th colspan="7">الإجمالي (@Model.Count نشاط)</th>
        <th>@Model.Sum(x => x.NumberBeneficiaries ?? 0)</th>
        <th>@Model.Sum(x => x.Cost ?? 0)</th>
        <th></th>
    </tr></tfoot>
</table></div></div>
<p class="small text-muted mt-2">تاريخ الطباعة: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
