@model Activity
@{ ViewData["Title"] = "تقرير النشاط #" + Model.Id; }
<div class="d-flex justify-content-between mb-3 no-print"><h3>تقرير النشاط</h3><button onclick="window.print()" class="btn btn-primary">طباعة</button></div>
<div class="card mb-3"><div class="card-body"><dl class="row mb-0">
    <dt class="col-sm-3">رقم النشاط</dt><dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">التاريخ</dt><dd class="col-sm-9">@Model.Date?.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">النوع</dt><dd class="col-sm-9">@Model.ActivityType.DisplayName()</dd>
    <dt class="col-sm-3">المكان</dt><dd class="col-sm-9">@Model.ActivityPlace (@Model.PlaceType.DisplayName())</dd>
    <dt class="col-sm-3">الموقع الإداري</dt><dd class="col-sm-9">@Model.Governorate?.Name / @Model.Office?.Name / @Model.Section?.Name / @Model.Subsid?.Name</dd>
    <dt class="col-sm-3">الخطة</dt><dd class="col-sm-9">@Model.Plan?.ActivityTitle</dd>
    <dt class="col-sm-3">الكلفة</dt><dd class="col-sm-9">@Model.Cost</dd>
    <dt class="col-sm-3">عدد الأفراد</dt><dd class="col-sm-9">@Model.NumberBeneficiaries</dd>
    <dt class="col-sm-3">ملاحظات</dt><dd class="col-sm-9">@Model.Note</dd>
</dl></div></div>
<div class="card"><div class="card-header fw-bold">مقيّمو النشاط</div><div class="table-responsive"><table class="table mb-0">
    <thead><tr><th>#</th><th>الاسم</th><th>الوظيفة / العنوان</th></tr></thead>
    <tbody>
    @{ int i = 1; }
    @foreach (var p in Model.People.OrderBy(x => x.Name)) { <tr><td>@(i++)</td><td>@p.Name</td><td>@p.FunctionAddress</td></tr> }
    </tbody>
</table></div></div>
