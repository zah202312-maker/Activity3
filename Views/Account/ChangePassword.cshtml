@{ ViewData["Title"] = "تغيير كلمة المرور"; }
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card"><div class="card-body p-4">
            <h4 class="mb-4">تغيير كلمة المرور</h4>
            @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
            <form method="post" asp-action="ChangePassword">
                <div class="mb-3"><label class="form-label">كلمة المرور القديمة</label><input name="oldPassword" type="password" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">كلمة المرور الجديدة</label><input name="newPassword" type="password" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">تأكيد كلمة المرور الجديدة</label><input name="confirmPassword" type="password" class="form-control" required /></div>
                <button class="btn btn-primary">حفظ</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </form>
        </div></div>
    </div>
</div>
