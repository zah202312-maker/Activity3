@model IPagedList
@*
    شريط ترقيم الصفحات المشترك.
    يحافظ على كل معاملات البحث الحالية في الرابط ويغيّر فقط page / pageSize.
*@
@{
    var query = Context.Request.Query;
    var path = Context.Request.Path;

    string PageUrl(int page, int? pageSize = null)
    {
        var values = new Dictionary<string, string?>();
        foreach (var kv in query)
        {
            if (kv.Key.Equals("page", StringComparison.OrdinalIgnoreCase) ||
                kv.Key.Equals("pageSize", StringComparison.OrdinalIgnoreCase)) continue;
            values[kv.Key] = kv.Value.ToString();
        }
        values["page"] = page.ToString();
        values["pageSize"] = (pageSize ?? Model.PageSize).ToString();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(path, values);
    }

    // نافذة أرقام حول الصفحة الحالية
    const int window = 2;
    var start = Math.Max(1, Model.Page - window);
    var end = Math.Min(Model.TotalPages, Model.Page + window);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 no-print">
    <div class="text-muted small">
        @if (Model.TotalCount == 0)
        {
            <span>لا توجد سجلات</span>
        }
        else
        {
            <span>عرض @Model.FirstItemIndex – @Model.LastItemIndex من أصل @Model.TotalCount</span>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="ترقيم الصفحات">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasPrevious ? PageUrl(1) : "#")" aria-label="الأولى">&laquo;</a>
                </li>
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasPrevious ? PageUrl(Model.Page - 1) : "#")">السابق</a>
                </li>

                @if (start > 1)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                    if (start > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                }

                @for (var i = start; i <= end; i++)
                {
                    if (i == Model.Page)
                    {
                        <li class="page-item active" aria-current="page"><span class="page-link">@i</span></li>
                    }
                    else
                    {
                        <li class="page-item"><a class="page-link" href="@PageUrl(i)">@i</a></li>
                    }
                }

                @if (end < Model.TotalPages)
                {
                    if (end < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasNext ? PageUrl(Model.Page + 1) : "#")">التالي</a>
                </li>
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasNext ? PageUrl(Model.TotalPages) : "#")" aria-label="الأخيرة">&raquo;</a>
                </li>
            </ul>
        </nav>
    }

    <div class="d-flex align-items-center gap-2 small">
        <label class="text-muted text-nowrap" for="pageSizeSelect">عدد السجلات بالصفحة</label>
        <select id="pageSizeSelect" class="form-select form-select-sm w-auto" onchange="window.location.href = this.value;">
            @foreach (var size in PagedList<object>.PageSizeOptions.Append(Model.PageSize).Distinct().OrderBy(s => s))
            {
                <option value="@PageUrl(1, size)" selected="@(size == Model.PageSize)">@size</option>
            }
        </select>
    </div>
</div>
