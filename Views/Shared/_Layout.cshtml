<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* تطبيق الوضع (ليلي/نهاري) قبل رسم الصفحة لتجنّب الوميض. الاختيار محفوظ في المتصفح، وإلا يتبع إعداد النظام *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('theme'); } catch (e) { }
            if (t !== 'dark' && t !== 'light')
                t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <title>@ViewData["Title"] - نظام إدارة الأنشطة</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary no-print">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">نظام إدارة الأنشطة</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Admin"))
                    {
                        @await Component.InvokeAsync("PendingActivityNotifications")
                    }
                    @* الترتيب: الأشخاص ← الخطط ← الأنشطة (للمدير والمستخدمين) *@
                    <li class="nav-item"><a class="nav-link" asp-controller="People" asp-action="Index">الأشخاص مقيمو النشاط</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Plans" asp-action="Index">الخطط</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index">الأنشطة</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Evaluation">تقييم النشاط</a></li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">المواقع</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Governorates" asp-action="Index">المحافظات</a></li>
                            <li><a class="dropdown-item" asp-controller="Offices" asp-action="Index">المكاتب</a></li>
                            <li><a class="dropdown-item" asp-controller="Sections" asp-action="Index">الأقسام</a></li>
                            <li><a class="dropdown-item" asp-controller="Subsids" asp-action="Index">الشعب</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">التقارير</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">الإدارة</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">المستخدمون</a></li>
                                <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">الأدوار</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <button type="button" class="nav-link btn btn-link" data-theme-toggle title="تبديل الوضع الليلي/النهاري">
                            <span class="theme-label-dark">🌙 الوضع الليلي</span><span class="theme-label-light">☀️ الوضع النهاري</span>
                        </button>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <button type="button" id="enableActivityAlerts" class="nav-link btn btn-link" style="display:none"
                                    title="السماح بصوت وإشعارات الأنشطة الجديدة">🔔 تفعيل التنبيهات</button>
                        </li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@User.Identity!.Name</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">تغيير كلمة المرور</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">
                            <button type="submit" class="nav-link btn btn-link">تسجيل الخروج</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
}
else
{
    @* صفحات بدون تسجيل دخول (مثل تسجيل الدخول): زر عائم لتبديل الوضع *@
    <button type="button" class="btn btn-sm btn-outline-secondary position-fixed top-0 start-0 m-3 no-print" style="z-index:1030"
            data-theme-toggle title="تبديل الوضع الليلي/النهاري">
        <span class="theme-label-dark">🌙 الوضع الليلي</span><span class="theme-label-light">☀️ الوضع النهاري</span>
    </button>
}
<main class="container-fluid py-4">
    @if (TempData["Ok"] is string ok) { <div class="alert alert-success alert-dismissible fade show no-print">@ok<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Err"] is string err) { <div class="alert alert-danger alert-dismissible fade show no-print">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>
@if (User.IsInRole("Admin"))
{
    @* تنبيهات الأنشطة الجديدة للمدير (انظر wwwroot/js/site.js) *@
    <div id="activityToasts" class="toast-container position-fixed bottom-0 start-0 p-3 no-print" style="z-index:1090"
         data-new-activities-url="@Url.Action("NewActivities", "Activities")"
         data-user="@User.Identity!.Name"></div>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
