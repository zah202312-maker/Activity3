@model Role
@{ ViewData["Title"] = Model.Id == 0 ? "دور جديد" : "تعديل دور"; }
<h3 class="mb-3">@ViewData["Title"]</h3>
<div class="card"><div class="card-body">
<form method="post" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id">
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ArRole" class="form-label"></label><input asp-for="ArRole" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" rows="3" class="form-control"></textarea></div>
    <button class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
</form>
</div></div>
