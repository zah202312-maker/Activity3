@model PagedList<Role>
@{ ViewData["Title"] = "الأدوار"; }
<div class="d-flex justify-content-between mb-3"><h3>الأدوار</h3><a asp-action="Create" class="btn btn-primary">دور جديد</a></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>#</th><th>الاسم</th><th>بالعربية</th><th>ملاحظات</th><th>المستخدمون</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr><td>@r.Id</td><td>@r.Name</td><td>@r.ArRole</td><td>@r.Note</td><td>@r.UserRoles.Count</td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('حذف الدور؟');"><button class="btn btn-sm btn-outline-danger">حذف</button></form>
            </td></tr>
    }
    </tbody>
</table></div></div>

<partial name="_Pagination" model="Model" />
