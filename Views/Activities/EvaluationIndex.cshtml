@model PagedList<Activity>
@{ ViewData["Title"] = "تقييم النشاط"; }
<h3 class="mb-3">تقييم النشاط</h3>
<form method="get" class="card card-body mb-3">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label for="fromDate" class="form-label">من تاريخ</label>
            <input id="fromDate" name="fromDate" type="date" class="form-control" value="@ViewBag.FromDate" />
        </div>
        <div class="col-md-2">
            <label for="toDate" class="form-label">إلى تاريخ</label>
            <input id="toDate" name="toDate" type="date" class="form-control" value="@ViewBag.ToDate" />
        </div>
        <div class="col-md-3">
            <label for="governorateId" class="form-label">المحافظة</label>
            <select id="governorateId" name="governorateId" class="form-select" asp-items="ViewBag.Governorates">
                <option value="">كل المحافظات</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="evaluationCompleted" class="form-label">حالة التقييم</label>
            <select id="evaluationCompleted" name="evaluationCompleted" class="form-select">
                <option value="">كل الحالات</option>
                <option value="true" selected="@(ViewBag.EvaluationCompleted == "true")">مكتمل</option>
                <option value="false" selected="@(ViewBag.EvaluationCompleted == "false")">غير مكتمل</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">بحث</button>
            <a asp-action="Evaluation" class="btn btn-outline-secondary">مسح الفلاتر</a>
        </div>
    </div>
</form>
<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <button type="button" id="printSelected" class="btn btn-primary" disabled>🖨 طباعة المحدد (<span id="selectedCount">0</span>)</button>
    <button type="button" id="clearSelected" class="btn btn-outline-secondary btn-sm" disabled>إلغاء التحديد</button>
    <small class="text-muted">حدّد نشاطاً أو أكثر (حتى من صفحات مختلفة) ثم اضغط «طباعة المحدد».</small>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th style="width:2.5rem"><input type="checkbox" class="form-check-input" id="selectAll" title="تحديد كل أنشطة الصفحة" /></th><th>#</th><th>التاريخ</th><th>المحافظة</th><th>مكان النشاط</th><th>عدد الأفراد</th><th>حالة التقييم</th><th>التقدير النهائي</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var activity in Model)
            {
                <tr>
                    <td><input type="checkbox" class="form-check-input eval-select" value="@activity.Id" aria-label="تحديد النشاط @activity.Id" /></td>
                    <td>@activity.Id</td>
                    <td>@activity.Date?.ToString("yyyy-MM-dd")</td>
                    <td>@activity.Governorate?.Name</td>
                    <td>@activity.ActivityPlace</td>
                    <td>@activity.NumberBeneficiaries</td>
                    <td>
                        @if (activity.EvaluationCompleted)
                        {
                            <span class="badge bg-success">تم التقييم</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">لم يكتمل التقييم</span>
                        }
                    </td>
                    <td>@(activity.OverallEvaluation ?? "—")</td>
                    <td class="text-end">
                        <a asp-action="EvaluationDetails" asp-route-id="@activity.Id" class="btn btn-sm btn-outline-primary">عرض التقييم</a>
                        <a asp-action="EvaluationPrint" asp-route-ids="@activity.Id" class="btn btn-sm btn-outline-secondary">طباعة</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted">لا توجد أنشطة.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />

@section Scripts {
<script>
(function () {
    const KEY = 'evalPrintSelection';
    const printUrl = '@Url.Action("EvaluationPrint")';
    let selected = [];
    try { selected = JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch { selected = []; }

    const boxes = [...document.querySelectorAll('.eval-select')];
    const all = document.getElementById('selectAll');
    const btn = document.getElementById('printSelected');
    const clear = document.getElementById('clearSelected');

    function save() { try { sessionStorage.setItem(KEY, JSON.stringify(selected)); } catch { } }
    function refresh() {
        document.getElementById('selectedCount').textContent = selected.length;
        btn.disabled = clear.disabled = selected.length === 0;
        const checked = boxes.filter(b => b.checked).length;
        all.checked = boxes.length > 0 && checked === boxes.length;
        all.indeterminate = checked > 0 && checked < boxes.length;
    }
    function toggle(id, on) {
        const i = selected.indexOf(id);
        if (on && i < 0) selected.push(id);
        if (!on && i >= 0) selected.splice(i, 1);
    }

    boxes.forEach(b => {
        b.checked = selected.includes(b.value);
        b.addEventListener('change', () => { toggle(b.value, b.checked); save(); refresh(); });
    });
    all.addEventListener('change', () => {
        boxes.forEach(b => { b.checked = all.checked; toggle(b.value, all.checked); });
        save(); refresh();
    });
    clear.addEventListener('click', () => {
        selected = []; boxes.forEach(b => b.checked = false); save(); refresh();
    });
    btn.addEventListener('click', () => {
        if (selected.length) location.href = printUrl + '?' + selected.map(id => 'ids=' + encodeURIComponent(id)).join('&');
    });
    refresh();
})();
</script>
}
