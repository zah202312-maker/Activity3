@model PagedList<Activity>
@{ ViewData["Title"] = "الأنشطة"; var qs = Context.Request.Query; }
<div class="d-flex justify-content-between mb-3"><h3>الأنشطة</h3><a asp-action="Create" class="btn btn-primary">نشاط جديد</a></div>

<form method="get" class="card card-body mb-3">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="row g-2">
        <div class="col-md-2"><input name="id" type="number" class="form-control" placeholder="رقم النشاط" value="@(qs["id"])" /></div>
        <div class="col-md-2"><input name="fromDate" type="date" class="form-control" value="@(qs["fromDate"])" /></div>
        <div class="col-md-2"><input name="toDate" type="date" class="form-control" value="@(qs["toDate"])" /></div>
        <div class="col-md-2">
            <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<ActivityType>()"><option value="">كل الأنواع</option></select>
        </div>
        <div class="col-md-2"><select name="governorateId" class="form-select" asp-items="ViewBag.Governorates"><option value="">كل المحافظات</option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100">بحث</button></div>
    </div>
</form>

<form id="bulkForm" method="post" asp-action="DeleteSelected" onsubmit="return confirm('حذف الأنشطة المحددة؟');">
    <button class="btn btn-sm btn-danger mb-2">حذف المحدد</button>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th><input type="checkbox" data-check-all="ids" /></th><th>#</th><th>التاريخ</th><th>النوع</th><th>المحافظة</th><th>المكتب</th><th>المكان</th><th>عدد الأفراد</th><th>الكلفة</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td><input type="checkbox" name="ids" value="@a.Id" form="bulkForm" /></td>
            <td>@a.Id</td><td>@a.Date?.ToString("yyyy-MM-dd")</td><td>@a.ActivityType.DisplayName()</td>
            <td>@a.Governorate?.Name</td><td>@a.Office?.Name</td><td>@a.ActivityPlace</td><td>@a.NumberBeneficiaries</td><td>@a.Cost</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">تفاصيل</a>
                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('حذف النشاط؟');"><button class="btn btn-sm btn-outline-danger">حذف</button></form>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="10" class="text-center text-muted">لا توجد نتائج.</td></tr> }
    </tbody>
</table></div></div>

<partial name="_Pagination" model="Model" />
